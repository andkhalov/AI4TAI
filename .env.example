# AI4TAI .env — скопируй в .env и заполни. Wizard (setup) делает это сам.

# === Yandex AI Studio (обязательно) ===
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# === Сайт technoavia.ru (необязательно; без токена — локальная копия каталога) ===
# Токен содержит символ | — держи его в кавычках.
# TARU_API="1234|abcdef"
# TARU_USER_ID=
# TARU_BASE_URL=https://technoavia.ru/api
# AI4TAI_SITE_MODE=auto        # auto | live | mock

# === Необязательно ===
# BRAVE_API_KEY=               # поиск через Brave вместо DuckDuckGo
# AI4TAI_EMBEDDER=yandex       # yandex | hash (без сети)
# AI4TAI_DB_PATH=data/demo.sqlite
# AI4TAI_RAG_DB=.rag/index.sqlite
# GOOSE_CONTEXT_LIMIT=128000
# GOOSE_MAX_TOKENS=16000
